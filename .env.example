# HomWisor Backend — MongoDB config
# Copy to .env and fill your URI
PORT=5000
# Long random string (32+ chars) — required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First super admin — only used when the admins collection is empty.
# If not set, admin@homwisor.com / admin123 is created and must be changed at first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MongoDB Atlas (recommended) — get from https://cloud.mongodb.com
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/homwisor?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/homwisor

# Or local MongoDB
# MONGODB_URI=mongodb://localhost:27017/homwisor

# If MONGODB_URI is empty / not set, backend falls back to file storage (data/db.json) — no Mongo needed

# Enquiry emails (nodemailer) — homwisor.com mail is hosted by Hostinger
# SMTP_USER = the mailbox that sends the emails (full address)
# SMTP_PASS = that mailbox's normal password (the one used to log in to Hostinger webmail)
# Leave SMTP_USER / SMTP_PASS empty to skip emails (enquiries are still saved).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEADS_EMAIL=leads@homwisor.com
SUPPORT_EMAIL=support@homwisor.com
# Used for page links inside the emails
SITE_URL=https://homwisor.com
